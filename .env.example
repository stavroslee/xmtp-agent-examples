WALLET_KEY= # the private key of the wallet
ENCRYPTION_KEY= # a second random 32 bytes encryption key for local db encryption

# Alchemy configuration
ALCHEMY_API_KEY= # Your Alchemy API key (e.g., 1234567890abcdef)

# Optional: GPT agent example
OPENAI_API_KEY= # the API key for the OpenAI API

# Optional: Agent configuration
POLL_INTERVAL_SECONDS=30 # How often to check for new conversations (10-5000 seconds, default: 30)